NODE_ENV=development
PORT=5000
HOST=0.0.0.0

MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/intellmeet?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your_long_random_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/v1/auth/microsoft/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@intellmeet.com

PASSWORD_RESET_URL=http://localhost:3000/reset-password

SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CALLBACK_URL=http://localhost:5000/api/v1/auth/saml/callback
SAML_CERT=

# WebRTC & Real-Time Meeting Configuration
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_TURN_HMAC_SECRET=
WEBRTC_TURN_CREDENTIAL_TTL=86400
MEETING_PARTICIPANT_LIMIT=50
MEETING_MESSAGE_MAX_CHARS=2000

# AI Intelligence Provider Configuration (gemini or openai)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Free Tier: gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
